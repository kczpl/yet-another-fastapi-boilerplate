# Copy to .env. Host commands use localhost; Compose overrides the service hosts.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql://app:app@localhost:5432/app
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# SHOW_DOCS defaults to true in development, false in staging/production.

API_PORT=8000
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
REDIS_PORT=6379

# Optional workers: uv sync --extra workers (or --extra ai, which includes workers).
REDIS_URL=redis://localhost:6379/0
# BROKER_VISIBILITY_TIMEOUT=3600      # exceed every task's hard limit + any ETA/countdown
# TASK_TIME_LIMIT=600
# WORKER_STOP_GRACE_PERIOD=11m        # Compose: exceed the longest task's hard limit
# Optional Docker AI stack: APP_EXTRA=ai docker compose --profile workers up --build

# Optional AI: use the standard AWS credential chain (export AWS_PROFILE or
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN; or an IAM role).
# Set BEDROCK_MODEL to an inference profile enabled for your account.
BEDROCK_REGION=eu-central-1

# Optional Sentry (staging/production only).
# SENTRY_DSN=
